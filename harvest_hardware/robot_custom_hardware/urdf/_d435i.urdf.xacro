<!--
This is the URDF model for the Intel RealSense 435i camera, in it's
aluminum peripherial evaluation case.

LOCAL COPY of realsense2_description's _d435i.urdf.xacro, changed to take a "prefix" param so
the robot can have two cameras (mast_camera_*, base_camera_*) without frame-name clashes.
amiga_ur_gripper.urdf.xacro includes this copy; ur_gripper.urdf.xacro uses the upstream one.

Usage:
  <xacro:sensor_d435i parent="some_link" prefix="mast_" use_nominal_extrinsics="true">
    <origin xyz="..." rpy="..."/>   <- pose of the camera's bottom screw hole in parent
  </xacro:sensor_d435i>
Frames created: ${prefix}camera_bottom_screw_frame, ${prefix}camera_link, and (when
use_nominal_extrinsics is true) ${prefix}camera_color_optical_frame, _depth_optical_frame, etc.
-->

<robot name="sensor_d435i" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="$(find realsense2_description)/urdf/_d435.urdf.xacro"/>
  <xacro:include filename="$(find realsense2_description)/urdf/_d435i_imu_modules.urdf.xacro"/>

  <!-- Added prefix param -->
  <xacro:macro name="sensor_d435i" params="parent prefix:='' *origin name:=camera use_nominal_extrinsics:=true">

    <!-- Pass prefix to submodules -->
    <xacro:sensor_d435 parent="${parent}" name="${prefix}${name}" use_nominal_extrinsics="${use_nominal_extrinsics}">
      <xacro:insert_block name="origin" />
    </xacro:sensor_d435>

    <xacro:d435i_imu_modules name="${prefix}${name}" use_nominal_extrinsics="${use_nominal_extrinsics}"/>

  </xacro:macro>
</robot>
