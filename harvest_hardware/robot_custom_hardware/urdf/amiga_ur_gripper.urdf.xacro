<?xml version="1.0"?>
<!--
  FULL ROBOT: Amiga platform + UR5e arm + gripper/ejector + two RealSense D435i cameras.

  Tree:  world -> amiga__base -> amiga__body -> amiga__tool0 (arm mount)
           -> UR5e (base_link ... wrist_3_link -> flange -> tool0)
                tool0 -> gripper_link (tip), ejector_link, mast camera, tracking marker
         amiga__base -> base camera

  Pieces live in:
    amiga.urdf.xacro    Amiga frame, its collision boxes, and where the arm mounts
    gripper.urdf.xacro  gripper body, ejector, suction-cup / palm / top camera frames
    _d435i.urdf.xacro   local copy of the RealSense macro with a "prefix" param added

  The arm + gripper WITHOUT the Amiga is ur_gripper.urdf.xacro. It duplicates gripper_joint
  below; keep the two in sync.

  UNITS: meters and radians (inches x 0.0254 = m, degrees x pi/180 = rad).
  tool0 axes: +z out of the flange along the gripper, -y toward the ejector/mast-camera side.

  To build by hand (e.g. to check a change):
    xacro amiga_ur_gripper.urdf.xacro name:=ur -o /tmp/robot.urdf && check_urdf /tmp/robot.urdf
  (name:=ur is needed because <robot name> is read before the default below is declared.)
  Restart robot_state_publisher / MoveIt / RViz to pick up changes; no rebuild needed
  (install/ symlinks back to these files).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="$(arg name)">

  <!-- UR driver args: these just pass through to ur_robot below. Launch files set most of them. -->
  <xacro:arg name="name" default="ur"/>
  <xacro:arg name="ur_type" default="ur5e"/>  <!-- absorbs CLI arg; we won't pass it to ur_robot -->
  <xacro:arg name="tf_prefix" default=""/>
  <xacro:arg name="transmission_hw_interface" default=""/>
  <xacro:arg name="safety_limits" default="false"/>
  <xacro:arg name="safety_pos_margin" default="0.15"/>
  <xacro:arg name="safety_k_position" default="20"/>
  <xacro:arg name="headless_mode" default="false"/>
  <xacro:arg name="robot_ip" default="0.0.0.0"/>
  <xacro:arg name="script_filename" default=""/>
  <xacro:arg name="output_recipe_filename" default=""/>
  <xacro:arg name="input_recipe_filename" default=""/>
  <xacro:arg name="reverse_ip" default="0.0.0.0"/>
  <xacro:arg name="script_command_port" default="50004"/>
  <xacro:arg name="reverse_port" default="50001"/>
  <xacro:arg name="script_sender_port" default="50002"/>
  <xacro:arg name="trajectory_port" default="50003"/>
  <xacro:arg name="use_tool_communication" default="false"/>
  <xacro:arg name="tool_voltage" default="0"/>
  <xacro:arg name="tool_parity" default="0"/>
  <xacro:arg name="tool_baud_rate" default="115200"/>
  <xacro:arg name="tool_stop_bits" default="1"/>
  <xacro:arg name="tool_rx_idle_chars" default="1.5"/>
  <xacro:arg name="tool_tx_idle_chars" default="3.5"/>
  <xacro:arg name="tool_device_name" default="/tmp/ttyUR"/>
  <xacro:arg name="tool_tcp_port" default="54321"/>
  <xacro:arg name="use_fake_hardware" default="false"/> 
  <xacro:arg name="fake_sensor_commands" default="false"/>
  <xacro:arg name="sim_gazebo" default="false"/>
  <xacro:arg name="sim_ignition" default="false"/>
  <xacro:arg name="simulation_controllers" default=""/>
  <!-- Joint angles the arm starts at in fake hardware / simulation -->
  <xacro:arg name="initial_positions_file" default="$(find robot_custom_hardware)/config/initial_positions.yaml"/>
  <xacro:property name="initial_positions_file" default="$(arg initial_positions_file)"/>

  <!-- Amiga args: prefix for every Amiga link name (amiga__base, amiga__body, amiga__tool0) -->
  <xacro:arg name="amiga_prefix" default="amiga__"/>

  <!-- Realsense args.
       true:  the URDF includes each camera's internal frames (depth / color / infra optical)
              at nominal factory offsets, e.g. mast_camera_color_optical_frame.
       false: the realsense driver must publish those frames itself. -->
  <xacro:arg name="use_nominal_extrinsics" default="true" />

  <!-- Define the four args with the names the UR macro expects -->
  <xacro:arg name="joint_limit_params" default="$(find robot_custom_hardware)/config/ur5e/joint_limits.yaml"/>
  <xacro:arg name="kinematics_params"  default="$(find robot_custom_hardware)/config/ur5e/default_kinematics.yaml"/>
  <xacro:arg name="physical_params"    default="$(find robot_custom_hardware)/config/ur5e/physical_parameters.yaml"/>
  <xacro:arg name="visual_params"      default="$(find robot_custom_hardware)/config/ur5e/visual_parameters.yaml"/>

  <!-- includes -->
  <xacro:include filename="$(find robot_custom_hardware)/urdf/amiga.urdf.xacro"/>
  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>
  <xacro:include filename="$(find robot_custom_hardware)/urdf/gripper.urdf.xacro"/>
  <xacro:include filename="$(find robot_custom_hardware)/urdf/_d435i.urdf.xacro"/>

  <!-- define world exactly once -->
  <link name="world"/>

  <!-- Instantiate Amiga, attached to world. 
       NOTE: your amiga macro signature requires mesh_base_path -->
  <xacro:property name="robot_custom_hardware" value="package://robot_custom_hardware/"/>
  <xacro:amiga_macro amiga_prefix="$(arg amiga_prefix)" amiga_parent="world" mesh_base_path="package://robot_custom_hardware/meshes/"/>

  <!-- UR5e arm, mounted on amiga__tool0 (mount pose is set in amiga.urdf.xacro) -->
  <xacro:ur_robot
      name="$(arg name)"
      tf_prefix="$(arg tf_prefix)"
      parent="$(arg amiga_prefix)tool0"

      joint_limits_parameters_file="$(arg joint_limit_params)"
      kinematics_parameters_file ="$(arg kinematics_params)"
      physical_parameters_file   ="$(arg physical_params)"
      visual_parameters_file     ="$(arg visual_params)"

      transmission_hw_interface="$(arg transmission_hw_interface)"
      safety_limits="$(arg safety_limits)"
      safety_pos_margin="$(arg safety_pos_margin)"
      safety_k_position="$(arg safety_k_position)"
      use_fake_hardware="$(arg use_fake_hardware)"
      fake_sensor_commands="$(arg fake_sensor_commands)"
      sim_gazebo ="$(arg sim_gazebo)"
      sim_ignition ="$(arg sim_ignition)"
      headless_mode="$(arg headless_mode)"
      initial_positions="${xacro.load_yaml(initial_positions_file)}"
      use_tool_communication="$(arg use_tool_communication)"
      tool_voltage="$(arg tool_voltage)"
      tool_parity="$(arg tool_parity)"
      tool_baud_rate="$(arg tool_baud_rate)"
      tool_stop_bits="$(arg tool_stop_bits)"
      tool_rx_idle_chars="$(arg tool_rx_idle_chars)"
      tool_tx_idle_chars="$(arg tool_tx_idle_chars)"
      tool_device_name="$(arg tool_device_name)"
      tool_tcp_port="$(arg tool_tcp_port)"
      robot_ip="$(arg robot_ip)"
      script_filename="$(arg script_filename)"
      output_recipe_filename="$(arg output_recipe_filename)"
      input_recipe_filename="$(arg input_recipe_filename)"
      reverse_ip="$(arg reverse_ip)"
      script_command_port="$(arg script_command_port)"
      reverse_port="$(arg reverse_port)"
      script_sender_port="$(arg script_sender_port)"
      trajectory_port="$(arg trajectory_port)">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:ur_robot>

  <!-- Gripper mount: gripper_link = the gripper TIP, 25 cm straight out from the flange
       (the gripper spans 1-25 cm). MoveIt drives this frame to pick targets, and
       start_harvest.py trigger_move_arm_to_pose stops it 15 cm short (world -y) of the apple.
       If you change this z:
         - make the same change in ur_gripper.urdf.xacro
         - shift the frames in gripper.urdf.xacro (they're relative to the tip)
         - recompute the gripper box center in gripper.urdf.xacro -->
  <joint name="gripper_joint" type="fixed">
    <parent link="tool0"/>
    <child  link="gripper_link"/>
    <origin xyz="0.00 0.00 0.25" rpy="0 0 0"/>
  </joint>

  <!-- Gripper body, ejector plate, suction-cup / palm / top camera frames -->
  <xacro:gripper_macro/>

  <!-- MAST RealSense (on the wrist), used for apple locations; apple_prediction.py reads
       mast_camera_color_optical_frame.
       Origin = the camera's bottom screw hole, relative to tool0:
         y = -0.09   9 cm over the wrist center (ejector side)
         z = 0.055   5.5 cm out from the flange
       rpy: the camera looks along +z (same direction as the gripper) with its top facing -y
       (away from the wrist). If apple positions come out mirrored or flipped, check this rotation. -->
  <xacro:sensor_d435i
    parent="tool0"
    prefix="mast_"
    use_nominal_extrinsics="$(arg use_nominal_extrinsics)">
    <origin xyz="0.0 -0.09 0.055" rpy="0 -1.57 1.57"/>
  </xacro:sensor_d435i>

  <!-- BASE RealSense (fixed on the Amiga), used for trunk detections.
       Relative to amiga__base: 0.3937 m (15.5 in) along +y, 0.5556 m (21.875 in) up,
       yawed 90 deg. -->
  <xacro:sensor_d435i
    parent="$(arg amiga_prefix)base"
    prefix="base_"
    use_nominal_extrinsics="$(arg use_nominal_extrinsics)">
    <origin xyz="0.0 0.3937 0.555625" rpy="0 0 1.57"/>
  </xacro:sensor_d435i>

  <!-- Tracking marker frame on the tool: 12 cm toward +y (the side opposite the ejector),
       3.7 cm out from the flange. Frame only; the 1 mm red sphere just makes it visible in
       RViz. No code references it by name. If the physical marker moved, update this. -->
  <joint name="tracking_marker_joint" type="fixed">
    <parent link="tool0"/>
    <child  link="tool0_tracking_marking_link"/>
    <origin xyz="0 0.12 0.037" rpy="0 0 0"/>
  </joint>
  <link name="tool0_tracking_marking_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.001"/>
      </geometry>
      <material name="marker_material">
        <color rgba="1 0 0 1"/>
      </material>
    </visual>
  </link>

</robot>
